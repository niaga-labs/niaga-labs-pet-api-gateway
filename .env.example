# api-gateway -- example environment.
#
# Copy to .env and adjust. .env is gitignored and never committed.
#
# Two ways to run -- see infrastructure/README.md:
#   1. Daily loop        shared dev-infra stack + `go run ./cmd/server` (these values)
#   2. Full-stack smoke  infrastructure/docker-compose.yml, where the upstreams
#                        below become service names instead of localhost

APP_ENV=development

# NOTE: Docker publishes niaga-dev-gateway on 8080 on the shared laptop, so this
# default collides -- see KPD-65. Override with GATEWAY_PORT=18080 if the bind fails.
GATEWAY_PORT=8080

RATE_LIMIT_PER_MIN=200

# Must be IDENTICAL to every service's JWT_SECRET, or the gateway rejects tokens
# service-identity issued. Replace outside development.
JWT_SECRET=dev-secret-change-me

# Upstreams. localhost for the daily loop; in docker-compose these become the
# container names (http://service-identity:8004 and so on), which is what the
# in-code defaults already assume.
UPSTREAM_IDENTITY=http://localhost:8004
UPSTREAM_BOOKING=http://localhost:8001
UPSTREAM_PAYMENT=http://localhost:8002
UPSTREAM_RUNNER=http://localhost:8003
UPSTREAM_TRACKING=http://localhost:8005
UPSTREAM_NOTIFICATION=http://localhost:8006
UPSTREAM_REVIEW=http://localhost:8007
